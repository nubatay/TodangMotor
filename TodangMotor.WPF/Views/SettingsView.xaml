<UserControl x:Class="TodangMotor.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F6FA"/>

        <Style x:Key="ActionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Canvas}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Backup &amp; Restore" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Protect your shop's data. Back up regularly, restore when needed." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Action Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Backup Card -->
            <Border Grid.Column="0" Style="{StaticResource ActionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#EEF1FF" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{StaticResource Brand}" FontSize="24"/>
                        </Border>
                        <TextBlock Text="Backup" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Save a complete copy of the current database to a .bak file." FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Row="1" Appearance="Primary" Content="Backup Now" Command="{Binding BackupCommand}" 
                               IsEnabled="{Binding IsNotBusy}" Background="{StaticResource Brand}" 
                               HorizontalAlignment="Left" Height="40" Padding="20,0" Margin="0,24,0,0"/>
                </Grid>
            </Border>

            <!-- Restore Card -->
            <Border Grid.Column="2" Style="{StaticResource ActionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#FEF2F2" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" Foreground="#EF4444" FontSize="24"/>
                        </Border>
                        <TextBlock Text="Restore" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Replace all current data with a previously saved backup." FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Row="1" Appearance="Secondary" Content="Restore Now" Command="{Binding RestoreCommand}" 
                               IsEnabled="{Binding IsNotBusy}" 
                               HorizontalAlignment="Left" Height="40" Padding="20,0" Margin="0,24,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Last Backup Info Card -->
        <Border Grid.Row="2" Style="{StaticResource ActionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Last Backup" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                    <ui:Button Appearance="Secondary" Content="Open Backup Folder" Command="{Binding OpenBackupFolderCommand}" 
                               Icon="{ui:SymbolIcon FolderOpen24}" HorizontalAlignment="Right" Height="36"/>
                </Grid>

                <!-- Stats Row -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding LastBackupDate}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Size" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding LastBackupSize}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Age" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding LastBackupAge}" FontSize="16" FontWeight="Bold" Foreground="{Binding LastBackupAgeColor}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Location Row -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Location" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding LastBackupLocation}" FontSize="13" Foreground="{StaticResource Ink}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>