<UserControl x:Class="TodangMotor.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- ===== Palette (same as Dashboard / Sidebar) ===== -->
        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6B84FF" Offset="0"/>
            <GradientStop Color="#4D6BFE" Offset="0.45"/>
            <GradientStop Color="#3347C9" Offset="1"/>
        </LinearGradientBrush>

        <!-- Clean TextBox (no default Windows focus lines) -->
        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="CleanPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input field: highlights with the brand color when focused -->
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="48"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4D6BFE"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Margin" Value="2,6,0,0"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4D6BFE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#4D6BFE" Opacity="0.28" BlurRadius="14" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B55D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2F44B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: BRANDING ================= -->
        <Grid Grid.Column="0" Background="{StaticResource HeroGradient}" ClipToBounds="True">
            <Ellipse Width="420" Height="420" Fill="#FFFFFF" Opacity="0.05" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,-140,0,0"/>
            <Ellipse Width="320" Height="320" Fill="#FFFFFF" Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                <!-- Logo -->
                <Border Height="170" Background="#FFFFFF" CornerRadius="18">
                    <Border.Effect>
                        <DropShadowEffect Color="#1F2A44" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/>
                    </Border.Effect>
                    <Image Source="/Assets/Logo.png" Stretch="Uniform" Margin="14"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="Run your shop with less paperwork." FontSize="24" FontWeight="Bold" Foreground="White"
                           TextWrapping="Wrap" Margin="0,40,0,8"/>
                <TextBlock Text="Inventory &amp; Sales Management System" FontSize="14" Foreground="#CCFFFFFF" Margin="0,0,0,28"/>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="10" Background="#26FFFFFF">
                            <ui:SymbolIcon Symbol="BoxMultiple24" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Live stock counts, no shelf-walking" Foreground="White" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="10" Background="#26FFFFFF">
                            <ui:SymbolIcon Symbol="Cart24" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Fast point of sale for every transaction" Foreground="White" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="#26FFFFFF">
                            <ui:SymbolIcon Symbol="DataBarVertical24" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Sales and profit at a glance" Foreground="White" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="v1.0  ·  Offline Mode" Foreground="#99FFFFFF" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32"/>
        </Grid>

        <!-- ================= RIGHT: LOGIN CARD ================= -->
        <Grid Grid.Column="1" Background="#F5F6FA">
            <Border Width="440" Background="#FFFFFF" CornerRadius="20" Padding="44,44,44,36"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.07" BlurRadius="40" ShadowDepth="8" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 0: Title -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Subtitle -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Username label -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: Username input -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Username error -->
                        <RowDefinition Height="Auto"/>
                        <!-- 5: Password label -->
                        <RowDefinition Height="Auto"/>
                        <!-- 6: Password input -->
                        <RowDefinition Height="Auto"/>
                        <!-- 7: Password error -->
                        <RowDefinition Height="Auto"/>
                        <!-- 8: Global error -->
                        <RowDefinition Height="Auto"/>
                        <!-- 9: Sign in button -->
                        <RowDefinition Height="Auto"/>
                        <!-- 10: Footer -->
                    </Grid.RowDefinitions>

                    <!-- Title & subtitle -->
                    <TextBlock Grid.Row="0" Text="Welcome back" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Row="1" Text="Sign in to manage your store." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,32"/>

                    <!-- Username -->
                    <TextBlock Grid.Row="2" Text="Username" Style="{StaticResource FieldLabel}"/>
                    <Border Grid.Row="3" Style="{StaticResource InputBorder}">
                        <Grid>
                            <ui:SymbolIcon Symbol="Person24" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBlock Text="Enter your username" Foreground="#94A3B8" FontSize="14" Margin="44,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=UserInput, Converter={StaticResource StringToVisibilityConverterReverse}}"/>
                            <TextBox x:Name="UserInput" Style="{StaticResource CleanTextBox}" Margin="42,0,12,0"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="4" Text="{Binding UsernameError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding UsernameError, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- Password -->
                    <TextBlock Grid.Row="5" Text="Password" Style="{StaticResource FieldLabel}" Margin="0,18,0,8"/>
                    <Border Grid.Row="6" Style="{StaticResource InputBorder}">
                        <Grid>
                            <ui:SymbolIcon Symbol="LockClosed24" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>

                            <!-- Placeholder -->
                            <TextBlock x:Name="PasswordPlaceholder" Text="Enter your password" Foreground="#94A3B8" FontSize="14" Margin="44,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

                            <!-- Hidden PasswordBox -->
                            <PasswordBox x:Name="PassInput" Style="{StaticResource CleanPasswordBox}" Margin="42,0,48,0"
                                         PasswordChanged="PassInput_PasswordChanged" KeyDown="PasswordBox_KeyDown"/>

                            <!-- Visible TextBox (when the eye is toggled) -->
                            <TextBox x:Name="PassInputPlain" Style="{StaticResource CleanTextBox}" Margin="42,0,48,0"
                                     Visibility="Collapsed" TextChanged="PassInputPlain_TextChanged" KeyDown="PasswordBox_KeyDown"/>

                            <!-- Eye toggle -->
                            <Button x:Name="TogglePasswordBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TogglePasswordBtn_Click" Focusable="False">
                                <ui:SymbolIcon x:Name="EyeIcon" Symbol="Eye24" Foreground="#94A3B8" FontSize="20"/>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="7" Text="{Binding PasswordError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding PasswordError, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- Global error (lockouts, server errors) -->
                    <Border Grid.Row="8" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,18,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="#EF4444" Margin="0,0,10,0" FontSize="18" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="13" TextWrapping="Wrap" MaxWidth="290" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Sign in -->
                    <Button Grid.Row="9" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SignInCommand}"
                            CommandParameter="{Binding ElementName=PassInput, Path=Password}"
                            Content="{Binding ButtonText}"
                            Margin="0,26,0,0"
                            IsEnabled="{Binding IsButtonEnabled}"/>

                    <!-- Spinner (white so it shows on the blue button) -->
                    <ui:ProgressRing Grid.Row="9" IsIndeterminate="True" Width="24" Height="24" Margin="0,26,0,0"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Footer -->
                    <Border Grid.Row="10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,18,0,0">
                        <TextBlock Text="Forgot your password? Contact the Owner." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
