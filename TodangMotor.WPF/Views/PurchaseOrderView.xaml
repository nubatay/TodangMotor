<UserControl x:Class="TodangMotor.WPF.Views.PurchaseOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:TodangMotor.WPF.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F6FA"/>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="42"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4D6BFE"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="CleanDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Height" Value="50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="LeftAlignedText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="CenterAlignedText" TargetType="TextBlock" BasedOn="{StaticResource LeftAlignedText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Modern TabControl Style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="Transparent" Padding="16,10" Margin="0,0,16,0" CornerRadius="8" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEF1FF"/>
                                <Setter Property="Foreground" Value="#4D6BFE"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Canvas}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Purchase Orders" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Create and manage orders for your suppliers." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Margin" Value="0,0,0,16"/>
                </Style>
            </TabControl.Resources>

            <!-- ================= TAB 1: BUILD PO ================= -->
            <TabItem Header="Build PO">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Order Details -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Supplier -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Supplier" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="SupplierName"
                                              Background="Transparent" BorderThickness="0" Margin="8,0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Order Date -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Order Date" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <DatePicker SelectedDate="{Binding OrderDate}" Background="Transparent" BorderThickness="0" Margin="8,0"/>
                                </Border>
                            </StackPanel>

                            <!-- Notes -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                <TextBlock Text="Notes (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <TextBox Style="{StaticResource CleanTextBox}" Margin="12,0" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Add Line Builder -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Product" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="ProductName"
                                              Background="Transparent" BorderThickness="0" Margin="8,0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quantity" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <TextBox Style="{StaticResource CleanTextBox}" Margin="12,0" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                            </StackPanel>

                            <ui:Button Grid.Column="4" Appearance="Secondary" Content="Add Line" Command="{Binding AddLineCommand}" 
                                       Icon="{ui:SymbolIcon Add24}" Height="42" Padding="16,0" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <!-- Current Lines Grid -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
                        <DataGrid Style="{StaticResource CleanDataGrid}" ItemsSource="{Binding CurrentLines}" Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" ElementStyle="{StaticResource LeftAlignedText}"/>
                                <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="1.5*" ElementStyle="{StaticResource LeftAlignedText}"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="100" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="100" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>

                                <DataGridTemplateColumn Header="" Width="80" HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Delete24" Foreground="#EF4444" FontSize="18"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Footer -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="{Binding TotalItemsText, StringFormat='Total Items: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalUnitsText, StringFormat='Total Units: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="150,0,0,0" VerticalAlignment="Center"/>

                        <ui:Button Appearance="Primary" Content="Save &amp; Generate PDF" Command="{Binding SaveAndExportCommand}" 
                                   Icon="{ui:SymbolIcon DocumentPdf24}" Background="{StaticResource Brand}" 
                                   HorizontalAlignment="Right" Height="42" Padding="20,0" IsEnabled="{Binding IsNotBusy}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: PO HISTORY ================= -->
            <TabItem Header="PO History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <Border Style="{StaticResource InputBorder}" Width="350" HorizontalAlignment="Left">
                            <Grid>
                                <ui:SymbolIcon Symbol="Search24" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                <TextBlock Text="Search PO number or supplier..." Foreground="#94A3B8" FontSize="14" Margin="44,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=SearchHistory, Converter={StaticResource StringToVisibilityConverterReverse}}"/>
                                <TextBox x:Name="SearchHistory" Style="{StaticResource CleanTextBox}" Margin="42,0,12,0"
                                         Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
                        <DataGrid Style="{StaticResource CleanDataGrid}" ItemsSource="{Binding HistoryItems}" Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PO Number" Binding="{Binding PONumber}" Width="1.5*" ElementStyle="{StaticResource LeftAlignedText}"/>
                                <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate}" Width="1.5*" ElementStyle="{StaticResource LeftAlignedText}"/>
                                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="2*" ElementStyle="{StaticResource LeftAlignedText}"/>
                                <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="100" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>

                                <DataGridTemplateColumn Header="" Width="100" HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Appearance="Secondary" Content="View" 
                                                       Command="{Binding DataContext.ViewPODetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                       CommandParameter="{Binding}" Height="28" Padding="12,0" FontSize="12" HorizontalAlignment="Center" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>