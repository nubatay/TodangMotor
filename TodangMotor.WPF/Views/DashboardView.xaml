<UserControl x:Class="TodangMotor.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ===== Palette ===== -->
        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="BrandTint" Color="#EEF1FF"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F6FA"/>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6B84FF" Offset="0"/>
            <GradientStop Color="#4D6BFE" Offset="0.45"/>
            <GradientStop Color="#3347C9" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== Cards ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="MinHeight" Value="112"/>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
        </Style>

        <Style x:Key="KpiSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="SectionSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,2,0,16"/>
        </Style>

        <!-- ===== Segmented filter ===== -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DDE2F2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4D6BFE"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Canvas}">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="360"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Header + filters -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Overview" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="Here is what is happening in your store." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="#E9ECF5" CornerRadius="11" Padding="4" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Today" GroupName="Filters" Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="Today" IsChecked="True"/>
                            <RadioButton Content="Last 7 Days" GroupName="Filters" Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="7d"/>
                            <RadioButton Content="Last 30 Days" GroupName="Filters" Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="30d"/>
                            <RadioButton Content="This Month" GroupName="Filters" Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="Month"/>
                            <RadioButton Content="Custom" GroupName="Filters" Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="Custom"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                                Visibility="{Binding IsCustomDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,8,0" Background="White" BorderBrush="{StaticResource Line}"/>
                        <TextBlock Text="to" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,8,0" Background="White" BorderBrush="{StaticResource Line}"/>
                        <ui:Button Content="Apply" Command="{Binding LoadDataCommand}" Appearance="Primary"
                                   Background="{StaticResource Brand}" Foreground="White" Padding="16,4" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ROW 1: KPIs. Hero (Sales) on the left, supporting metrics in a 2-column grid on the right.
                 Every card has Margin=8; the negative margin on the grid cancels it at the edges. -->
            <Grid Grid.Row="1" Margin="-8,-8,-8,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- HERO: Sales -->
                <Border Grid.Column="0" Margin="8" Padding="28" CornerRadius="20" Background="{StaticResource HeroGradient}" MinHeight="240">
                    <Border.Effect>
                        <DropShadowEffect Color="#4D6BFE" Opacity="0.28" BlurRadius="28" ShadowDepth="8" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="12" Background="#33FFFFFF">
                                <ui:SymbolIcon Symbol="Money24" Foreground="White" FontSize="22"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Sales" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Total for the selected period" FontSize="12" Foreground="#CCFFFFFF"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding SalesValue}" FontSize="46" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <Border Background="White" CornerRadius="12" Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SalesTrend}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding SalesTrendColor}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Supporting KPIs -->
                <UniformGrid Grid.Column="1" Columns="2">
                    <!-- Net Profit (owner only) -->
                    <Border Style="{StaticResource KpiCard}" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#DCFCE7">
                                    <ui:SymbolIcon Symbol="MoneyHand24" Foreground="#16A34A" FontSize="18"/>
                                </Border>
                                <TextBlock Text="Net Profit" Style="{StaticResource KpiLabel}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding NetProfitValue}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding NetProfitSub}" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <!-- Transactions -->
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#EDE9FE">
                                    <ui:SymbolIcon Symbol="Receipt24" Foreground="#7C3AED" FontSize="18"/>
                                </Border>
                                <TextBlock Text="Transactions" Style="{StaticResource KpiLabel}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TransactionsValue}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding TransactionsTrend}" FontSize="12" Foreground="{Binding TransactionsTrendColor}"/>
                        </StackPanel>
                    </Border>

                    <!-- Items Sold -->
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#FEF3C7">
                                    <ui:SymbolIcon Symbol="BoxMultiple24" Foreground="#D97706" FontSize="18"/>
                                </Border>
                                <TextBlock Text="Items Sold" Style="{StaticResource KpiLabel}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ItemsSoldValue}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding ItemsSoldSub}" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <!-- Stock Alerts -->
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#FEE2E2">
                                    <ui:SymbolIcon Symbol="Warning24" Foreground="#DC2626" FontSize="18"/>
                                </Border>
                                <TextBlock Text="Stock Alerts" Style="{StaticResource KpiLabel}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StockAlertsValue}" Style="{StaticResource KpiValue}" Foreground="{Binding StockAlertsColor}"/>
                            <TextBlock Text="{Binding StockAlertsSub}" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- ROW 2: Charts -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Sales trend: smooth area/line chart -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding SalesChartTitle}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="How sales moved over time" Style="{StaticResource SectionSub}"/>
                        </StackPanel>
                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding SalesTrendSeries}"
                                            XAxes="{Binding SalesTrendXAxes}"
                                            YAxes="{Binding SalesTrendYAxes}"
                                            TooltipPosition="Top" ZoomMode="None" DrawMargin="60,10,20,40"/>
                    </Grid>
                </Border>

                <!-- Top products: ranked horizontal bars -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Top Products" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Best sellers by revenue" Style="{StaticResource SectionSub}"/>
                        </StackPanel>
                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding TopProductsSeries}"
                                            YAxes="{Binding TopProductsYAxes}"
                                            XAxes="{Binding TopProductsXAxes}"
                                            TooltipPosition="Top" ZoomMode="None" DrawMargin="120,10,20,30"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 3: Lists -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recent Sales -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Recent Sales" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="340">
                            <ItemsControl ItemsSource="{Binding RecentSales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandTint}" VerticalAlignment="Top">
                                                    <ui:SymbolIcon Symbol="Receipt24" Foreground="{StaticResource Brand}" FontSize="18"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                    <TextBlock Text="{Binding ItemsSummary}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" ToolTip="{Binding ItemsSummary}"/>
                                                    <TextBlock Text="{Binding MetaData}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SubtotalFormatted}" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Stock Alerts -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Stock Alerts" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24"
                                        Visibility="{Binding HasNoStockAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Width="64" Height="64" CornerRadius="32" Background="#DCFCE7" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#16A34A" FontSize="32"/>
                                </Border>
                                <TextBlock Text="All products are healthy!" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                                <TextBlock Text="No items are below reorder levels." FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340"
                                          Visibility="{Binding HasStockAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding StockAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding ColorHex}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,0,10,0" ToolTip="{Binding Name}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding QuantityText}" FontWeight="Bold" Foreground="{Binding ColorHex}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
