<ui:FluentWindow x:Class="TodangMotor.WPF.Views.PurchaseOrderDetailDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Purchase Order Detail"
                 Height="700" Width="700"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="#F5F6FA">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="24">
            <Border Background="#FFFFFF" Padding="32" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.08" BlurRadius="20" ShadowDepth="4" Direction="270"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="PURCHASE ORDER" FontSize="12" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtPONumber" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Text="Order Date:" FontSize="12" Foreground="#64748B" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" x:Name="TxtOrderDate" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>

                        <TextBlock Grid.Column="2" Text="Supplier:" FontSize="12" Foreground="#64748B" Margin="24,0,8,0"/>
                        <TextBlock Grid.Column="3" x:Name="TxtSupplier" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                    </Grid>

                    <Rectangle Height="1" Fill="#E2E8F0" Margin="0,0,0,16"/>

                    <!-- Lines Grid -->
                    <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" Background="Transparent" BorderThickness="0" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Brand" Binding="{Binding ProductBrand}" Width="150"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding ProductUnit}" Width="80"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Rectangle Height="1" Fill="#E2E8F0" Margin="0,16"/>

                    <Grid>
                        <TextBlock x:Name="TxtNotes" FontSize="12" Foreground="#64748B" FontStyle="Italic" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtTotalItems" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Secondary" Content="Close" Click="Close_Click" Width="100" Height="40" Margin="0,0,12,0"/>
                    <ui:Button Appearance="Primary" Content="Export PDF" Click="ExportPdf_Click" Icon="{ui:SymbolIcon DocumentPdf24}" Width="140" Height="40" Background="#4D6BFE"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>