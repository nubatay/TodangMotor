<ui:FluentWindow x:Class="TodangMotor.WPF.Views.UserDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding DialogTitle}"
                 Height="680" Width="600"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="#F5F6FA"
                 FocusManager.FocusedElement="{Binding ElementName=UsernameInput}">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>
        <SolidColorBrush x:Key="Danger" Color="#EF4444"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4D6BFE"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- FIXED ERROR TEXT STYLE -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Visible"/>
            <!-- Default to Visible -->
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,32,32,0">

                <!-- 1. Username -->
                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox x:Name="UsernameInput" TabIndex="0" Style="{StaticResource CleanTextBox}" Margin="12,0" 
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                    </Border>
                    <TextBlock Text="{Binding UsernameError}" Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- 2. Full Name -->
                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Full Name" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox TabIndex="1" Style="{StaticResource CleanTextBox}" Margin="12,0" 
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                    </Border>
                    <TextBlock Text="{Binding FullNameError}" Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- 3. Role -->
                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <ComboBox TabIndex="2" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" 
                                  Background="Transparent" BorderThickness="0" Margin="8,0" VerticalContentAlignment="Center" FontSize="14"/>
                    </Border>
                </StackPanel>

                <!-- 4. Password -->
                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <ui:PasswordBox x:Name="PasswordInput" TabIndex="3" Margin="12,0" Background="Transparent" BorderThickness="0" 
                                        FontSize="14" PasswordChanged="PasswordInput_PasswordChanged"/>
                    </Border>
                    <TextBlock Text="{Binding PasswordError}" Style="{StaticResource ErrorText}"/>
                    <TextBlock Text="{Binding PasswordHint}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,4,0,0"/>
                </StackPanel>

                <!-- 5. Confirm Password -->
                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <ui:PasswordBox x:Name="ConfirmPasswordInput" TabIndex="4" Margin="12,0" Background="Transparent" BorderThickness="0" 
                                        FontSize="14" PasswordChanged="ConfirmPasswordInput_PasswordChanged"/>
                    </Border>
                    <TextBlock Text="{Binding ConfirmPasswordError}" Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- Global Error -->
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,20"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button TabIndex="6" Appearance="Secondary" Content="Cancel" Command="{Binding CancelCommand}" Width="100" Height="40" Margin="0,0,12,0"/>

                    <!-- FIXED: Bound directly to IsNotBusy -->
                    <ui:Button TabIndex="5" Appearance="Primary" Content="Save" Command="{Binding SaveCommand}" Width="120" Height="40" 
                               Background="{StaticResource Brand}" IsEnabled="{Binding IsNotBusy}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>