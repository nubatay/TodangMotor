<ui:FluentWindow x:Class="TodangMotor.WPF.Views.SupplierDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding DialogTitle}"
                 Height="520" Width="600"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="#F5F6FA"
                 FocusManager.FocusedElement="{Binding ElementName=SupplierNameInput}">

    <!-- KEYBOARD SHORTCUTS ADDED HERE -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4D6BFE"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- BULLETPROOF ERROR STYLE -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,32,32,0">

                <!-- Supplier Name -->
                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Supplier Name" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox x:Name="SupplierNameInput" Style="{StaticResource CleanTextBox}" Margin="12,0" 
                                 Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <TextBlock Text="{Binding SupplierNameError}" Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- Contact Number -->
                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Contact Number" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox Style="{StaticResource CleanTextBox}" Margin="12,0" 
                                 Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <TextBlock Text="{Binding ContactNumberError}" Style="{StaticResource ErrorText}"/>

                    <TextBlock Text="Format: 09XXXXXXXXX (11 digits)" 
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="2,4,0,0"/>
                </StackPanel>

                <!-- Address -->
                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Address (Optional)" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox Style="{StaticResource CleanTextBox}" Margin="12,0" 
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Secondary" Content="Cancel" Command="{Binding CancelCommand}" Width="100" Height="40" Margin="0,0,12,0"/>
                    <ui:Button Appearance="Primary" Content="Save" Command="{Binding SaveCommand}" Width="120" Height="40" 
                               Background="{StaticResource Brand}" IsEnabled="{Binding IsNotBusy}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>