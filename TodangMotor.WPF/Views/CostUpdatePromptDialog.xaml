<ui:FluentWindow x:Class="TodangMotor.WPF.Views.CostUpdatePromptDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Update Product Costs?"
                 Height="600" Width="800"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="#F5F6FA">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding UpdateCostsCommand}" />
        <KeyBinding Key="Escape" Command="{Binding KeepCurrentCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>

        <!-- DataGrid Styles -->
        <Style x:Key="CleanDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="LeftAlignedText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="CenterAlignedText" TargetType="TextBlock" BasedOn="{StaticResource LeftAlignedText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="24">
            <StackPanel>
                <TextBlock Text="Stock-In saved successfully." FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="The following product(s) were delivered at a cost that differs from their current Cost Price. Update the product Cost Price to match?" 
                           FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,24"/>

                <!-- Will be Updated Grid -->
                <StackPanel Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,24">
                    <TextBlock Text="WILL BE UPDATED" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brand}" Margin="0,0,0,8"/>
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                        <DataGrid Style="{StaticResource CleanDataGrid}" ItemsSource="{Binding Changes}" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" ElementStyle="{StaticResource LeftAlignedText}"/>
                                <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="150" ElementStyle="{StaticResource LeftAlignedText}"/>
                                <DataGridTextColumn Header="Current Cost" Binding="{Binding CurrentCost, StringFormat=C2}" Width="120" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>
                                <DataGridTextColumn Header="New Cost" Binding="{Binding NewCost, StringFormat=C2}" Width="120" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

                <!-- Skipped Grid -->
                <StackPanel Visibility="{Binding HasSkipped, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="⚠ SKIPPED — new cost exceeds current selling price" FontSize="12" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,8"/>
                    <Border Background="#FFFFFF" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8">
                        <DataGrid Style="{StaticResource CleanDataGrid}" ItemsSource="{Binding Skipped}" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" ElementStyle="{StaticResource LeftAlignedText}"/>
                                <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="150" ElementStyle="{StaticResource LeftAlignedText}"/>
                                <DataGridTextColumn Header="New Cost" Binding="{Binding NewCost, StringFormat=C2}" Width="120" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>
                                <DataGridTextColumn Header="Selling Price" Binding="{Binding CurrentSellingPrice, StringFormat=C2}" Width="120" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Secondary" Content="Keep Current" Command="{Binding KeepCurrentCommand}" Width="140" Height="40" Margin="0,0,12,0"/>
                    <ui:Button Appearance="Primary" Content="Update Costs" Command="{Binding UpdateCostsCommand}" Width="140" Height="40" 
                               Background="{StaticResource Brand}" IsEnabled="{Binding HasChanges}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>