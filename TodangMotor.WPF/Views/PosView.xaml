<UserControl x:Class="TodangMotor.WPF.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TodangMotor.WPF.ViewModels">

    <UserControl.Resources>
        <!-- ===== Palette ===== -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="BrandTint" Color="#EEF1FF"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F6FA"/>

        <!-- ===== Cards & Styles ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4D6BFE"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4D6BFE"/>
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#4D6BFE" Opacity="0.15" BlurRadius="15" ShadowDepth="4" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Canvas}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Point of Sale" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Select products to process a new transaction." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Split View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: PRODUCTS ================= -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search & Filter -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InputBorder}" Height="46">
                            <Grid>
                                <ui:SymbolIcon Symbol="Search24" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                <TextBlock Text="Search product or brand..." Foreground="#94A3B8" FontSize="14" Margin="44,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=SearchInput, Converter={StaticResource StringToVisibilityConverterReverse}}"/>
                                <TextBox x:Name="SearchInput" Style="{StaticResource CleanTextBox}" Margin="42,0,12,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Product Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Clickable Product Card -->
                                    <Border Style="{StaticResource ProductCard}" 
                                            MouseLeftButtonUp="ProductCard_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding ProductName}" FontWeight="Bold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Brand}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>

                                            <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding SellingPrice, StringFormat=C2}" FontWeight="Bold" Foreground="{StaticResource Brand}" FontSize="16"/>
                                                <TextBlock Text="{Binding QuantityOnHand, StringFormat='Stock: {0}'}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= RIGHT: CART ================= -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cart Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Current Order" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <ui:Button Appearance="Danger" Content="Clear" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearCartCommand}" 
                                   HorizontalAlignment="Right" Padding="8,4" FontSize="12"/>
                    </Grid>

                    <!-- Cart Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat=C2}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Quantity Input -->
                                                <Border Style="{StaticResource InputBorder}" Width="50" Height="30" Margin="0,0,10,0" Background="#FFFFFF">
                                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                                                             FontWeight="Bold" Foreground="{StaticResource Brand}"
                                                             Background="Transparent" BorderThickness="0"/>
                                                </Border>

                                                <TextBlock Text="{Binding LineTotal, StringFormat=C2}" FontWeight="Bold" Foreground="{StaticResource Ink}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>

                                                <Button Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0">
                                                    <ui:SymbolIcon Symbol="Dismiss24" Foreground="#EF4444" FontSize="18"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Checkout Section -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,10,0,0">
                        <StackPanel>

                            <!-- Totals -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Subtotal" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding SubtotalText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="Change" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding ChangeText}" FontSize="22" FontWeight="Bold" Foreground="{Binding ChangeColor}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- Customer Name -->
                            <TextBlock Text="Customer Name (Optional)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,12">
                                <TextBox Style="{StaticResource CleanTextBox}" Margin="12,0" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>

                            <!-- Payment Method -->
                            <TextBlock Text="Payment Method" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedValue="{Binding PaymentMethod}" Margin="0,0,0,12" Height="40" Background="#F8FAFC" BorderBrush="#E2E8F0">
                                <ComboBoxItem Content="Cash" IsSelected="True"/>
                                <ComboBoxItem Content="GCash"/>
                            </ComboBox>

                            <!-- Cash Input -->
                            <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Amount Tendered" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Money24" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        <TextBox Style="{StaticResource CleanTextBox}" Margin="42,0,12,0" Text="{Binding TenderedAmountText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                                <!-- INLINE VALIDATION -->
                                <TextBlock Text="{Binding TenderedError}" Foreground="#EF4444" FontSize="12" Margin="2,4,0,0" 
                                           Visibility="{Binding TenderedError, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- GCash Input -->
                            <StackPanel Visibility="{Binding IsGcash, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="GCash Reference No." Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Phone24" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        <TextBox Style="{StaticResource CleanTextBox}" Margin="42,0,12,0" Text="{Binding GcashReference, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                                <!-- INLINE VALIDATION -->
                                <TextBlock Text="{Binding GcashError}" Foreground="#EF4444" FontSize="12" Margin="2,4,0,0" 
                                           Visibility="{Binding GcashError, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Complete Sale Button -->
                            <ui:Button Appearance="Primary" Content="Complete Sale" Command="{Binding CompleteSaleCommand}" 
                                       Height="50" Margin="0,20,0,0" HorizontalAlignment="Stretch" FontSize="16" FontWeight="Bold"
                                       Background="{StaticResource Brand}" IsEnabled="{Binding IsNotBusy}"/>

                            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,20,0,0" HorizontalAlignment="Center"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>