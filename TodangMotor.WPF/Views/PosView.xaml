<UserControl x:Class="TodangMotor.WPF.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TodangMotor.WPF.ViewModels">

    <UserControl.Resources>
        <!-- ===== Palette (Golden Standard) ===== -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="BrandTint" Color="#EEF1FF"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F6FA"/>
        <SolidColorBrush x:Key="Danger" Color="#EF4444"/>

        <!-- ===== Cards ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Form styles ===== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4D6BFE"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- ===== Inline error text ===== -->
        <Style x:Key="InlineError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===== Subtotal / Change pill ===== -->
        <Style x:Key="TotalCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <!-- ===== Touch-friendly product tile ===== -->
        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Width" Value="230"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="8" ShadowDepth="1" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4D6BFE"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#4D6BFE" Opacity="0.18" BlurRadius="18" ShadowDepth="4" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding QuantityOnHand}" Value="0">
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ===== Product card tooltip ===== -->
        <Style x:Key="ProductTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" Opacity="0.08"
                                          BlurRadius="12" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Canvas}" Margin="28"
      PreviewKeyDown="PosView_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Point of Sale" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Select products to process a new transaction." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ================= SPLIT ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>

            <!-- =================================================== -->
            <!-- LEFT: PRODUCTS                                      -->
            <!-- =================================================== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Border Grid.Row="0" Style="{StaticResource InputBorder}" Height="46" Margin="0,0,0,20">
                        <Grid>
                            <ui:SymbolIcon Symbol="Search24" Foreground="#94A3B8" FontSize="18"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBlock Text="Search product or brand..."
                                       Foreground="#94A3B8" FontSize="14" Margin="44,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=SearchInput,
                                           Converter={StaticResource StringToVisibilityConverterReverse}}"/>
                            <TextBox x:Name="SearchInput" Style="{StaticResource CleanTextBox}" Margin="42,0,12,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchInput_PreviewKeyDown"/>
                        </Grid>
                    </Border>

                    <!-- Tiles -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredProducts}">
                                <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ProductTileRoot"
                                                Style="{StaticResource ProductCard}"
                                                MouseLeftButtonUp="ProductCard_Click"
                                                Tag="{Binding}"
                                                ToolTipService.InitialShowDelay="350"
                                                ToolTipService.ShowDuration="15000"
                                                ToolTipService.Placement="Mouse"
                                                ToolTipService.HorizontalOffset="14"
                                                ToolTipService.VerticalOffset="-46"
                                                ToolTipService.BetweenShowDelay="0"
                                                ToolTipService.ShowOnDisabled="False">
                                            <Border.ToolTip>
                                                <ToolTip Style="{StaticResource ProductTooltipStyle}"
                                                     IsHitTestVisible="False"
                                                     Focusable="False">
                                                    <TextBlock Text="{Binding ProductName}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="320"/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="{Binding ProductName}"
                                                   FontWeight="Bold" FontSize="14"
                                                   Foreground="{StaticResource Ink}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,58,0"/>

                                                 <TextBlock Grid.Row="1" Text="{Binding Brand}"
                                                   FontSize="12" Foreground="{StaticResource Muted}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>

                                                 <TextBlock Grid.Row="2"
                                                   Text="{Binding SellingPrice, StringFormat=C2}"
                                                   FontWeight="Bold" FontSize="20"
                                                   Foreground="{StaticResource Brand}"
                                                   VerticalAlignment="Bottom"/>

                                                <!-- Stock pill (Patch 3 output) -->
                                                <Border Grid.Row="3" CornerRadius="8" Padding="8,3"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BrandTint}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding QuantityOnHand}" Value="0">
                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Brand}"/>
                                                                <Setter Property="Text"
                                                                    Value="{Binding QuantityOnHand, StringFormat='Stock: {0}'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding QuantityOnHand}" Value="0">
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                        <Setter Property="Text" Value="OUT OF STOCK"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Hover affordance (Patch 4, fixed) — overlays the whole grid -->
                                                <Border x:Name="AddChip"
                                                        Grid.Row="0" Grid.RowSpan="4"
                                                        Visibility="Collapsed"
                                                        Background="{StaticResource Brand}"
                                                        CornerRadius="8" Padding="8,4"
                                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                                        IsHitTestVisible="False">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Add24" FontSize="12" Foreground="White"/>
                                                        <TextBlock Text="Add" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="White" Margin="4,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ProductTileRoot}" Value="True">
                                                <Setter TargetName="AddChip" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty search overlay -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredProducts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="Search24" FontSize="36"
                                       Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                            <TextBlock Text="No products found"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,10,0,2"/>
                            <TextBlock Text="Try a different search or product name"
                                   FontSize="12" Foreground="#94A3B8"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- =================================================== -->
            <!-- RIGHT: CART + CHECKOUT                              -->
            <!-- =================================================== -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cart header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Current Order" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                        <ui:Button Appearance="Danger" Content="Clear"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding ClearCartCommand}"
                                   HorizontalAlignment="Right" Padding="10,4" FontSize="12"
                                   Cursor="Hand"/>
                    </Grid>

                    <!-- Cart items -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}"
                                            BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource Ink}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat=C2}"
                                                           FontSize="12" Foreground="{StaticResource Muted}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <!-- Quantity -->
                                                <Border Style="{StaticResource InputBorder}"
                                                    Width="52" Height="32" Margin="0,0,12,0"
                                                    Background="#FFFFFF">
                                                         <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         Padding="0"
                                                         FontWeight="Bold" FontSize="13"
                                                         Foreground="{StaticResource Brand}"
                                                         Background="Transparent" BorderThickness="0"
                                                         FocusVisualStyle="{x:Null}"
                                                         PreviewMouseWheel="QuantityBox_PreviewMouseWheel"/>            
                                                </Border>

                                                <!-- Line total -->
                                                <TextBlock Text="{Binding LineTotal, StringFormat=C2}"
                                                           FontWeight="Bold" FontSize="13"
                                                           Foreground="{StaticResource Ink}"
                                                           Width="72" TextAlignment="Right"
                                                           VerticalAlignment="Center"/>

                                                <!-- Remove -->
                                                <Button Command="{Binding DataContext.RemoveFromCartCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Margin="10,0,0,0" Padding="4">
                                                    <ui:SymbolIcon Symbol="Dismiss24"
                                                                   Foreground="#EF4444" FontSize="16"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty cart overlay -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cart.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="Cart24" FontSize="36"
                                       Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cart is empty"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,10,0,2"/>
                            <TextBlock Text="Tap a product to begin"
                                   FontSize="12" Foreground="#94A3B8"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Checkout -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,10,0,0">
                        <StackPanel>

                            <!-- Totals -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Subtotal -->
                                <Border Grid.Column="0" Style="{StaticResource TotalCard}" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Text="SUBTOTAL"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Muted}"/>
                                                            <TextBlock Text="{Binding SubtotalText}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Ink}"
                                           Margin="0,4,0,0"/>
                                     </StackPanel>
                                 </Border>

                                  <!-- Change -->
                                  <Border Grid.Column="1" Style="{StaticResource TotalCard}" Margin="10,0,0,0">
                                     <StackPanel>
                                        <TextBlock Text="CHANGE"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Muted}"
                                           HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding ChangeText}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{Binding ChangeColor}"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           LineHeight="26"
                                           Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Customer name -->
                            <TextBlock Text="Customer Name (Optional)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,12">
                                <TextBox x:Name="CustomerNameInput" Style="{StaticResource CleanTextBox}" Margin="12,0"
                                    Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>

                            <!-- Payment method -->
                            <TextBlock Text="Payment Method" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Height="44" Margin="0,0,0,12">
                                <ComboBox SelectedValue="{Binding PaymentMethod}"
                                  SelectedValuePath="Content"
                                  Background="Transparent" BorderThickness="0"
                                  Margin="8,0" VerticalContentAlignment="Center"
                                  FontSize="14" Cursor="Hand">
                                    <ComboBoxItem Content="Cash"/>
                                    <ComboBoxItem Content="GCash"/>
                                </ComboBox>
                            </Border>

                            <!-- CASH -->
                            <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Amount Tendered" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource InputBorder}" Height="52">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Money24" Foreground="#94A3B8" FontSize="20"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Margin="16,0,0,0"/>
                                        <TextBox Style="{StaticResource CleanTextBox}"
                                                 Margin="48,0,14,0"
                                                 FontSize="18" FontWeight="SemiBold"
                                                 Text="{Binding TenderedAmountText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding TenderedError}"
                                           Style="{StaticResource InlineError}"
                                           Visibility="{Binding TenderedError,
                                               Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- GCASH -->
                            <StackPanel Visibility="{Binding IsGcash, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="GCash Reference No." Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource InputBorder}" Height="52">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Phone24" Foreground="#94A3B8" FontSize="20"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Margin="16,0,0,0"/>
                                        <TextBox Style="{StaticResource CleanTextBox}"
                                                 Margin="48,0,14,0"
                                                 FontSize="16" FontWeight="SemiBold"
                                                 Text="{Binding GcashReference, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding GcashError}"
                                           Style="{StaticResource InlineError}"
                                           Visibility="{Binding GcashError,
                                               Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Complete Sale -->
                            <ui:Button Appearance="Primary" Content="Complete Sale"
           Command="{Binding CompleteSaleCommand}"
           Height="52" Margin="0,20,0,0"
           HorizontalAlignment="Stretch"
           FontSize="16" FontWeight="Bold"
           Background="{StaticResource Brand}">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="IsEnabled" Value="{Binding IsNotBusy}"/>
                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                        <Setter Property="ToolTipService.Placement" Value="Top"/>
                                        <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                                        <Style.Triggers>
                                            <!-- Priority 4 (lowest): field-specific messages -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCash}" Value="True"/>
                                                    <Condition Binding="{Binding TenderedAmountText}" Value=""/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="ToolTip" Value="Enter the amount tendered to complete the sale"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGcash}" Value="True"/>
                                                    <Condition Binding="{Binding GcashReference}" Value=""/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="ToolTip" Value="Enter the GCash reference number to complete the sale"/>
                                            </MultiDataTrigger>

                                            <!-- Priority 2: cart empty -->
                                            <DataTrigger Binding="{Binding Cart.Count}" Value="0">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="ToolTip" Value="Add at least one item to the cart first"/>
                                            </DataTrigger>

                                            <!-- Priority 1 (highest): busy — always wins -->
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="ToolTip" Value="Processing sale, please wait..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24"
                                             Margin="0,16,0,0" HorizontalAlignment="Center"
                                             Visibility="{Binding IsBusy,
                                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>