<UserControl x:Class="TodangMotor.WPF.Views.StockInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:TodangMotor.WPF.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F6FA"/>

        <!-- Input Styles -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="42"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4D6BFE"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="CleanDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Height" Value="50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="LeftAlignedText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="CenterAlignedText" TargetType="TextBlock" BasedOn="{StaticResource LeftAlignedText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="FormCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Canvas}" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Stock-In" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Record incoming deliveries from your suppliers." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Delivery Details Card -->
        <Border Grid.Row="1" Style="{StaticResource FormCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="SupplierName"
                                  Background="Transparent" BorderThickness="0" Margin="8,0" VerticalContentAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Delivery Date" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <DatePicker SelectedDate="{Binding DeliveryDate}" Background="Transparent" BorderThickness="0" Margin="8,0"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Reference No. (Optional)" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox Style="{StaticResource CleanTextBox}" Margin="12,0" Text="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Notes (Optional)" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox Style="{StaticResource CleanTextBox}" Margin="12,0" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Line Builder Card -->
        <Border Grid.Row="2" Style="{StaticResource FormCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Product" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="ProductName"
                                  Background="Transparent" BorderThickness="0" Margin="8,0" VerticalContentAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox Style="{StaticResource CleanTextBox}" Margin="12,0" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <TextBlock Text="{Binding QuantityError}" Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Unit Cost (₱)" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox Style="{StaticResource CleanTextBox}" Margin="12,0" Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <TextBlock Text="{Binding UnitCostError}" Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <ui:Button Grid.Column="6" Appearance="Primary" Content="Add Line" Command="{Binding AddLineCommand}" 
                           Icon="{ui:SymbolIcon Add24}" Background="{StaticResource Brand}" 
                           Height="42" Padding="16,0" VerticalAlignment="Top" Margin="0,25,0,0"/>
            </Grid>
        </Border>

        <!-- Line Items DataGrid -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Margin="0,0,0,16">
            <DataGrid Style="{StaticResource CleanDataGrid}" ItemsSource="{Binding CurrentLines}" Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" ElementStyle="{StaticResource LeftAlignedText}"/>
                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="1.5*" ElementStyle="{StaticResource LeftAlignedText}"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>
                    <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat=C2}" Width="120" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=C2}" Width="120" HeaderStyle="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterAlignedText}"/>

                    <DataGridTemplateColumn Header="" Width="60" HeaderStyle="{StaticResource CenterHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Delete24" Foreground="#EF4444" FontSize="18"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer (Totals & Complete) -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalItemsText, StringFormat='Items: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="{Binding TotalUnitsText, StringFormat='Units: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="24,0,0,0"/>
                <TextBlock Text="{Binding TotalCostText, StringFormat='Total Cost: {0}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brand}" Margin="24,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,16,0" 
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <ui:Button Appearance="Primary" Content="Complete Stock-In" Command="{Binding CompleteStockInCommand}" 
                           Icon="{ui:SymbolIcon CheckmarkCircle24}" Background="{StaticResource Brand}" 
                           Height="44" Padding="24,0" FontSize="15" FontWeight="SemiBold" IsEnabled="{Binding IsNotBusy}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>