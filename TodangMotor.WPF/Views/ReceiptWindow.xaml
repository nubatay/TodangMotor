<ui:FluentWindow x:Class="TodangMotor.WPF.Views.ReceiptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Receipt"
                 Width="420"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="#F5F6FA">

    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>
    </ui:FluentWindow.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The Printable Area -->
        <Border x:Name="ReceiptPrintArea" Grid.Row="0" Background="White" 
                BorderBrush="{StaticResource Line}" BorderThickness="1" 
                CornerRadius="8" Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="16" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <TextBlock Text="TODANG MOTOR" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                <TextBlock Text="Parts &amp; Accessories" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock Text="Lower Tamugan, Marilog, Davao City" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,16"/>

                <!-- Meta Data -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding InvoiceNo}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="{Binding DateFormatted}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CashierName, StringFormat='Cashier: {0}'}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding PaymentMethod, StringFormat='Payment: {0}'}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding GcashReference, StringFormat='Ref: {0}'}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                   Visibility="{Binding GcashReference, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding CustomerName, StringFormat='Customer: {0}'}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>

                <!-- Items Header -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="QTY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="1" Text="ITEM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="2" Text="AMOUNT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Items List -->
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Quantity}" FontSize="12" Foreground="{StaticResource Ink}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="12" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding LineTotalFormatted}" FontSize="12" Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,12"/>

                <!-- Totals -->
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Subtotal" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding SubtotalFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,6" Visibility="{Binding IsCash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Tendered" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding TenderedFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,6" Visibility="{Binding IsCash, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Change" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="{Binding ChangeFormatted}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brand}" HorizontalAlignment="Right"/>
                </Grid>

                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>

                <!-- Footer -->
                <TextBlock Text="We appreciate your business!" FontSize="12" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="This serves as your official receipt." FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Secondary" Content="Close" Click="Close_Click" Width="100" Height="40" Margin="0,0,12,0"/>
                <ui:Button Appearance="Primary" Content="Print Receipt" Icon="{ui:SymbolIcon Print24}" Click="Print_Click" Width="140" Height="40" Background="{StaticResource Brand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>