<Application x:Class="TodangMotor.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TodangMotor.WPF.ViewModels"
             xmlns:views="clr-namespace:TodangMotor.WPF.Views"
             xmlns:conv="clr-namespace:TodangMotor.WPF.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <conv:StringToVisibilityConverterReverse x:Key="StringToVisibilityConverterReverse" />
            <conv:ActionIconConverter x:Key="ActionIconConverter" />
            <conv:StringEqualsMultiConverter x:Key="StringEqualsMultiConverter" />

            <!-- Navigation DataTemplates -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PosViewModel}">
                <views:PosView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SalesHistoryViewModel}">
                <views:SalesHistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ItemsViewModel}">
                <views:ItemsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                <views:CategoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SupplierViewModel}">
                <views:SupplierView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UserViewModel}">
                <views:UserView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:StockInViewModel}">
                <views:StockInView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <!-- Purchase Order View -->
            <DataTemplate DataType="{x:Type vm:PurchaseOrderViewModel}">
                <views:PurchaseOrderView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>