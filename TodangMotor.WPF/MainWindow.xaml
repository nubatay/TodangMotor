<ui:FluentWindow x:Class="TodangMotor.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="TodangMotor POS" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="#F5F6FA">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="BrandTint" Color="#EEF1FF"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>

        <!-- Navigation Styles -->
        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="24,20,24,6"/>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Margin="12,2" Padding="14,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandTint}"/>
                                <Setter Property="Foreground" Value="#4D6BFE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Brand}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutItem" TargetType="Button">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Margin="12,0" Padding="14,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Window Control Buttons -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- STRICT GRID LAYOUT -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <!-- Title Bar Height -->
            <RowDefinition Height="*"/>
            <!-- Main Content Area -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- CHANGED TO AUTO: This column will shrink to 0 when the sidebar is hidden -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= TITLE BAR (Spans Full Width) ================= -->
        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" ShowMinimize="False" ShowMaximize="False" ShowClose="False" Background="Transparent">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click">
                        <ui:SymbolIcon Symbol="Subtract24" FontSize="14" Foreground="{StaticResource Ink}"/>
                    </Button>
                    <Button Style="{StaticResource WindowControlButton}" Click="Maximize_Click">
                        <ui:SymbolIcon x:Name="MaximizeIcon" Symbol="Square24" FontSize="12" Foreground="{StaticResource Ink}"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{StaticResource Ink}"/>
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ================= SIDEBAR ================= -->
        <!-- CHANGED: Added Width="220" back to the Border -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="220" Background="White"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Image Grid.Row="1" Source="/Assets/Logo.png" Stretch="Uniform" Height="96" Margin="-20,16,-19,16"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Menu -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
                    <StackPanel>
                        <!-- MAIN -->
                        <TextBlock Text="MAIN" Style="{StaticResource NavSection}" Margin="24,8,24,6"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True" Command="{Binding NavigateToDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="18"/>
                                <TextBlock Text="Dashboard" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToPosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="18"/>
                                <TextBlock Text="POS" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToSalesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Receipt24" FontSize="18"/>
                                <TextBlock Text="Sales" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- CATALOG (Owner) -->
                        <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="CATALOG" Style="{StaticResource NavSection}"/>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToItemsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Library24" FontSize="18"/>
                                    <TextBlock Text="Items" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToCategoriesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Tag24" FontSize="18"/>
                                    <TextBlock Text="Categories" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToSuppliersCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PeopleCommunity24" FontSize="18"/>
                                    <TextBlock Text="Suppliers" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- STOCK -->
                        <TextBlock Text="STOCK" Style="{StaticResource NavSection}"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToInventoriesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Archive24" FontSize="18"/>
                                <TextBlock Text="Inventory" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- STOCK IN & PO (Owner) -->
                        <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToStockInCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="18"/>
                                    <TextBlock Text="Stock-In" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToPurchaseOrdersCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Cart24" FontSize="18"/>
                                    <TextBlock Text="Purchase Orders" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- ADMIN (Owner) -->
                        <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="ADMIN" Style="{StaticResource NavSection}"/>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToUsersCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="18"/>
                                    <TextBlock Text="Users" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToReportsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="18"/>
                                    <TextBlock Text="Reports" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToSettingsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="18"/>
                                    <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logout -->
                <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                    <Button Style="{StaticResource LogoutItem}" Command="{Binding LogoutCommand}" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Power24" FontSize="18"/>
                            <TextBlock Text="Logout" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="10"/>
    </Grid>
</ui:FluentWindow>