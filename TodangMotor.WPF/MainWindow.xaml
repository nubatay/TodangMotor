<ui:FluentWindow x:Class="TodangMotor.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="TodangMotor POS" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="#F5F6FA">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ===== Palette (same as DashboardView) ===== -->
        <SolidColorBrush x:Key="Brand" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="BrandTint" Color="#EEF1FF"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#EAECF3"/>

        <!-- ===== Section label (MAIN, CATALOG, STOCK, ADMIN) ===== -->
        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="24,20,24,6"/>
        </Style>

        <!-- ===== Nav item (radio so only one is active at a time) ===== -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Margin="12,2" Padding="14,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandTint}"/>
                                <Setter Property="Foreground" Value="#4D6BFE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Brand}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Logout item (button, turns red on hover) ===== -->
        <Style x:Key="LogoutItem" TargetType="Button">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Margin="12,0" Padding="14,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Width="220" Background="White"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Image Grid.Row="0" Source="/Assets/Logo.png" Stretch="Uniform" Height="96" Margin="-20,16,-19,16"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Menu -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,12" Margin="0,112,0,0" Grid.RowSpan="2">
                    <StackPanel>
                        <TextBlock Text="MAIN" Style="{StaticResource NavSection}" Margin="24,8,24,6"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True" Command="{Binding NavigateToDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="18"/>
                                <TextBlock Text="Dashboard" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToPosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="18"/>
                                <TextBlock Text="POS" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <!-- TODO: add Command="{Binding ...}" once the Sales screen exists -->
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Receipt24" FontSize="18"/>
                                <TextBlock Text="Sales" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="CATALOG" Style="{StaticResource NavSection}"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToItemsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Library24" FontSize="18"/>
                                <TextBlock Text="Items" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToCategoriesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Tag24" FontSize="18"/>
                                <TextBlock Text="Categories" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToSuppliersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PeopleCommunity24" FontSize="18"/>
                                <TextBlock Text="Suppliers" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="STOCK" Style="{StaticResource NavSection}"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Archive24" FontSize="18"/>
                                <TextBlock Text="Inventory" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="18"/>
                                <TextBlock Text="Stock-In" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Cart24" FontSize="18"/>
                                <TextBlock Text="Purchase Orders" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="ADMIN" Style="{StaticResource NavSection}"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateToUsersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Person24" FontSize="18"/>
                                <TextBlock Text="Users" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="18"/>
                                <TextBlock Text="Reports" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18"/>
                                <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Logout -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                    <Button Style="{StaticResource LogoutItem}" Command="{Binding LogoutCommand}" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Power24" FontSize="18"/>
                            <TextBlock Text="Logout" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ================= CONTENT ================= -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="10"/>
    </Grid>
</ui:FluentWindow>
